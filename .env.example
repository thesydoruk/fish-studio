# Fish Speech TTS server + dataset builder — project config
# Copy:  cp .env.example .env
#
# Full Ukrainian LoRA path: docs/ukrainian-lora-playbook.md
# Docker Compose overrides DATA_ROOT and FISH_SPEECH_BASE_URL on its own.

# --- paths (work/, datasets/, checkpoints/, training/, logs/) ---
# Root for all runtime artifacts (work/, datasets/, checkpoints/, training/, logs/).
DATA_ROOT=./data

# --- sources (JSON array for fish-dataset run; processed sequentially) ---
# YouTube / local sources to process. Empty = no downloads; merge still sees on-disk datasets.
# SOURCES=[{"id":"youtube-channel-1","kind":"youtube","enabled":true,"url":"https://www.youtube.com/@CHANNEL/videos","speaker_name":"host"}]
SOURCES=[]

# --- audio_intel (remote transcription) ---
# Server must enable matching flags: WORD_ALIGN_ENABLED, SPEAKERS_ENABLED (+ HF_TOKEN),
# SOUND_EVENTS_ENABLED. Request flags below are ignored when the server feature is off.
# With SOUND_EVENTS_ENABLED, keep ASR_PARALLEL_WORKERS low (1–2) to avoid CUDA OOM.
# audio-intel HTTP base (word alignment, diarization, sound events).
AUDIO_INTEL_BASE_URL=http://127.0.0.1:8081
# ASR language. "auto" for bilingual UK/EN lessons; "uk" for monolingual Ukrainian.
AUDIO_INTEL_LANGUAGE=uk
# Request word timestamps (required for clip cuts). Ignored if the server has align off.
AUDIO_INTEL_ALIGN=true
# Request speaker diarization. Ignored if the server has speakers off.
AUDIO_INTEL_DIARIZE=true
# Request PANNs sound-event labels (junk filter). Ignored if the server feature is off.
AUDIO_INTEL_SOUND_EVENTS=true
# Per-file transcription timeout (seconds). Long videos need an hour-scale budget.
AUDIO_INTEL_TIMEOUT_SEC=7200
# Drop spans that came back with no word alignment instead of keeping uncut audio.
AUDIO_INTEL_DROP_FAILED_SEGMENTS=true

# --- segmentation ---
# Drop clips shorter than this after merge/split.
SEGMENTATION_MIN_DURATION_SEC=1.5
# Keep this at or above FISH_SPEECH_CHUNK_LENGTH / 14 (chars per second of Ukrainian
# speech). A LoRA learns how long an utterance lasts, so clips shorter than one
# synthesis request teach the model to stop before the line is finished.
SEGMENTATION_MAX_DURATION_SEC=20.0
# Preferred clip length when splitting a long same-speaker run.
SEGMENTATION_TARGET_DURATION_SEC=12.0
# Drop a clip if aligned speech inside it is shorter than this.
SEGMENTATION_MIN_SPEECH_DURATION_SEC=0.5
# Drop clips whose transcript is shorter than this (junk / breath fragments).
SEGMENTATION_MIN_CHARS=10
# Above MAX_DURATION_SEC * 14 so duration, not text, is what ends a clip.
SEGMENTATION_MAX_CHARS=320
# Extra audio kept on each side of the aligned span.
SEGMENTATION_PADDING_SEC=0.05
# Match Fish Speech s2-pro codec sample rate.
SEGMENTATION_SAMPLE_RATE=44100
# Adjacent same-speaker segments join across gaps this short. Below ~0.5 s an
# ordinary sentence pause blocks every merge and clips stay near one sentence.
SEGMENTATION_MERGE_GAP_SEC=0.6
# true drops non-uk when AUDIO_INTEL_LANGUAGE=uk. For bilingual auto ASR, set false.
SEGMENTATION_FILTER_NON_TARGET_LANGUAGE=true
# Split aligned words into uk/en runs (Latin vs Cyrillic). On for bilingual teachers.
SEGMENTATION_SPLIT_BY_SCRIPT=false
# Keep only these languages after script split. Russian and other LID tags are dropped.
SEGMENTATION_ALLOWED_LANGUAGES=uk,en
# Run loudnorm on export. When true, QUALITY_* volume gates are skipped.
SEGMENTATION_NORMALIZE_LOUDNESS=true
# loudnorm integrated loudness target (LUFS).
SEGMENTATION_TARGET_LOUDNESS_LUFS=-18.0
# loudnorm true-peak ceiling (dBTP).
SEGMENTATION_TRUE_PEAK_DB=-1.0
# loudnorm loudness range (LU).
SEGMENTATION_LOUDNESS_RANGE=7.0
# Strip leading/trailing silence before loudnorm. HF corpora ship clips padded
# with 1-2 s of digital silence; training on those makes synthesis fade out.
# Pauses inside an utterance are never touched.
SEGMENTATION_TRIM_SILENCE=true
# Silence threshold (dBFS) for the edge trim.
SEGMENTATION_TRIM_SILENCE_DB=-50.0
# Keep this much silence at each edge after trim so clips do not click.
SEGMENTATION_TRIM_SILENCE_KEEP_SEC=0.05

# --- quality ---
# Whisper mean log-probability floor. Lower = more uncertain transcripts kept.
QUALITY_MIN_AVG_LOGPROB=-1.0
# Drop segments Whisper tagged as likely non-speech.
QUALITY_MAX_NO_SPEECH_PROB=0.6
# Drop clips whose compression ratio looks like a Whisper repetition loop.
QUALITY_DROP_COMPRESSION_RATIO_OUTLIERS=true
# Compression-ratio ceiling used as a hallucination / loop proxy.
QUALITY_MAX_COMPRESSION_RATIO=2.4
# Mean word-alignment confidence floor.
QUALITY_MIN_AVG_WORD_SCORE=0.5
# Single-word alignment floor; words below this count toward the low-score ratio.
QUALITY_MIN_WORD_SCORE=0.25
# Drop a clip if this fraction of its words fall below QUALITY_MIN_WORD_SCORE.
QUALITY_MAX_LOW_SCORE_WORD_RATIO=0.35
# Skipped when SEGMENTATION_NORMALIZE_LOUDNESS=true — loudnorm rewrites levels on export.
QUALITY_FILTER_AUDIO_QUALITY=true
# Mean-volume floor (dBFS) when QUALITY_FILTER_AUDIO_QUALITY is on.
QUALITY_MIN_MEAN_VOLUME_DB=-40.0
# Mean-volume ceiling (dBFS) — rejects clipped / over-hot takes.
QUALITY_MAX_MEAN_VOLUME_DB=-8.0
# Peak-volume ceiling (dBFS).
QUALITY_MAX_PEAK_VOLUME_DB=-1.0
# Non-speech junk filtering is hardcoded: any clip overlapping a sound_event is
# dropped. Requires AUDIO_INTEL_SOUND_EVENTS=true and server SOUND_EVENTS_ENABLED=1.

# --- export ---
# Fallback speaker label written into the pipe-delimited dataset (overridden per SOURCES entry).
EXPORT_SPEAKER_NAME=speaker
# Fraction of clips held out for validation.
EXPORT_EVAL_SPLIT_SIZE=0.05
# RNG seed for the train/eval split.
EXPORT_SEED=42
# Prefer a clone-reference WAV near this length when picking one per speaker.
EXPORT_REFERENCE_DURATION_SEC=8.0
# Sample rate of the exported reference WAV (s2-pro codec is 44100).
EXPORT_REFERENCE_SAMPLE_RATE=44100

# --- speaker clustering (cross-video within one SOURCES channel) ---
# Cosine threshold for merging video-local speakers into {EXPORT_SPEAKER_NAME}_s{k}.
# Requires diarization roster embeddings in transcript JSON.
SPEAKER_CLUSTER_THRESHOLD=0.75
# After cluster remap, drop speakers below either floor (junk diarization tails).
SPEAKER_CLUSTER_MIN_CLIPS=100
# Minimum aggregated speech (seconds) to keep a clustered speaker.
SPEAKER_CLUSTER_MIN_SPEECH_SEC=300

# --- pipeline ---
# Which fish-dataset steps to run: all, or a comma list (download, transcribe, segment, …).
PIPELINE_STEPS=all
# Re-run steps even when outputs already exist.
PIPELINE_FORCE=false
# Worker processes for CPU-bound pipeline stages (segment / export).
PIPELINE_NUM_WORKERS=6

# --- training (./run.sh train / bg-train) ---
# Dataset folder under data/datasets/ (usually the merge output of ./run.sh dataset merge -o combined).
TRAINING_DATASET_ID=combined
# Speaker name used when a clip has none; also the default for speaker-weight grouping.
TRAINING_SPEAKER_NAME=speaker
# Run directory name: training/runs/<name>/. Change this for each fresh train.
TRAINING_PROJECT_NAME=fish-uk
# Optional override for the stock s2-pro LLAMA dir. Empty = checkpoints/fish-speech/s2-pro.
TRAINING_BASE_CHECKPOINT=
# Optional override for the merged-checkpoint dir. Empty = training/merged/.
TRAINING_MERGED_CHECKPOINT=
# Trainer max_steps.
TRAINING_MAX_STEPS=1000
# Per-step micro-batch (clips). OOM: lower this and raise TRAINING_GRAD_ACCUM.
TRAINING_BATCH_SIZE=4
# Gradient accumulation. Effective batch = BATCH_SIZE × GRAD_ACCUM (here 16).
TRAINING_GRAD_ACCUM=4
# Adam learning rate.
TRAINING_LR=5e-05
# Run validation every N steps (and write a checkpoint at the same cadence).
TRAINING_VAL_CHECK_INTERVAL=500
# Checkpoints to retain; -1 keeps every one (~97 MB) so the best step can be chosen by ear.
TRAINING_SAVE_TOP_K=-1
# Hydra LoRA config name written for train/merge (must match r / alpha below).
TRAINING_LORA_CONFIG=r_32_alpha_64
# LoRA rank. Higher = more capacity (and more clone risk on attention/mlp).
TRAINING_LORA_R=32
# LoRA alpha. Effective scale is alpha/r (here 2.0).
TRAINING_LORA_ALPHA=64
# LoRA dropout on adapted modules.
TRAINING_LORA_DROPOUT=0.01
# Slow text→semantic stack. fast_* is timbre — list it explicitly to train the decoder.
# 'embeddings' is the text token table (semantic id rows stay frozen in train).
TRAINING_LORA_TARGET_MODULES=attention,mlp,embeddings
# After merge: W = stock + scale × (ft − stock). 1.0 is a raw fold (kills clone).
TRAINING_MERGE_SCALE=0.5
# Cap per-speaker sampling weight so huge folders do not own every step (0 = raw counts).
TRAINING_MAX_SPEAKER_WEIGHT=10000
# When a speaker has EN and UK clips, this fraction of pairs is EN-ref → UK-target.
TRAINING_CROSS_LINGUAL_PROB=0.7
# Resume path. auto = latest ckpt in training/runs/<project>/checkpoints/. Empty = from base.
TRAINING_CONTINUE_PATH=auto
# VQ encode batch size (clips per GPU step when building semantic codes).
TRAINING_VQ_BATCH_SIZE=8
# DataLoader workers for VQ encode. Keep 1 unless CPU/RAM is idle.
TRAINING_VQ_NUM_WORKERS=1
# Workers for packing proto shards after VQ.
TRAINING_PROTO_NUM_WORKERS=8
# Target proto shard size (MB) written under training/protos/.
TRAINING_PROTO_SHARD_SIZE_MB=10
# Line used by ./run.sh train infer for a quick smoke synthesis.
TRAINING_TEST_TEXT=Доброго дня! Вартість квитка 150 грн, знижка 10 відсотків.

# --- stress marks (Ukrainian lexical stress) ---
# Applied during dataset/train export AND to synthesis input. The model learns to
# read the marks during fine-tuning, so changing these after export means re-export
# (./run.sh train export) → vq → protos → retrain from the base checkpoint.
# Insert combining acute (U+0301) on Ukrainian words.
STRESS_ENABLED=true
# skip = leave unresolved heteronyms unmarked; first = guess; all = mark every option.
STRESS_ON_AMBIGUITY=skip
# dictionary = lookup only; stanza = context-aware heteronyms (+~500 MB, needs `pip install stanza`).
STRESS_DISAMBIGUATION=stanza
# Custom overrides (names / OOV). Relative to this .env file. Empty disables.
STRESS_LEXICON_PATH=configs/stress_lexicon.txt
# Keep Stanza on CPU so marking does not contend with the TTS GPU.
STRESS_PREFER_CPU=true
# Mark remaining OOV words from clip energy during dataset export (not used at synthesis).
STRESS_ACOUSTIC_FALLBACK=true

# --- inference (HTTP TTS server) ---
# Bind address for ./run.sh server start.
INFERENCE_HOST=0.0.0.0
# Bind port for the HTTP TTS proxy.
INFERENCE_PORT=8080
# Device hint for CLI infer / native engine (vLLM always uses CUDA).
INFERENCE_DEVICE=cuda
# Default language tag on synthesize requests.
INFERENCE_LANGUAGE=uk
# Max uploaded reference audio (bytes). 15728640 = 15 MiB.
INFERENCE_MAX_UPLOAD_BYTES=15728640

# --- fish_speech (vLLM-Omni: ./run.sh vllm start) ---
# vLLM-Omni HTTP base the TTS proxy talks to.
FISH_SPEECH_BASE_URL=http://127.0.0.1:8091
# Host port vLLM listens on.
VLLM_PORT=8091
# Host port published for vLLM when using Docker Compose.
VLLM_PUBLISH_PORT=8091
# Host port published for the HTTP TTS server when using Docker Compose.
SERVER_PUBLISH_PORT=8080
# Weights vLLM loads (relative to DATA_ROOT, or a HuggingFace id). Live serve uses training/vllm.
FISH_SPEECH_MODEL=checkpoints/fish-speech/s2-pro
# Keep in sync with stage 0 in configs/fish_speech_deploy.yaml.
FISH_SPEECH_GPU_MEMORY_UTILIZATION=0.72
# Reduce CUDA allocator fragmentation so DAC can use leftover VRAM.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Default voice name sent to vLLM when the request omits one.
FISH_SPEECH_VOICE=default
# HTTP timeout (seconds) for one synthesize call to vLLM.
FISH_SPEECH_TIMEOUT_SEC=300.0
# Stock / train-time LLAMA dir (relative to DATA_ROOT). Used by LoRA train and CLI infer.
FISH_SPEECH_LLAMA_CHECKPOINT=checkpoints/fish-speech/s2-pro
# Optional separate DAC decoder checkpoint. Empty = the one bundled with the LLAMA dir.
FISH_SPEECH_DECODER_CHECKPOINT=
# Hydra decoder config name (s2-pro = modded_dac_vq).
FISH_SPEECH_DECODER_CONFIG_NAME=modded_dac_vq
# Load LLAMA in fp16/bf16 for CLI infer.
FISH_SPEECH_HALF=true
# torch.compile the native infer engine (not vLLM). Off unless you measured a win.
FISH_SPEECH_COMPILE=false
# Max characters per vLLM request. Longer text is split on sentence boundaries.
# This is the longest span one generation must sustain, so SEGMENTATION_MAX_DURATION_SEC
# has to cover it: 200 chars is about 14 s of Ukrainian speech.
FISH_SPEECH_CHUNK_LENGTH=200
# Max new tokens per request. 0 = vLLM server default.
FISH_SPEECH_MAX_NEW_TOKENS=0
# vLLM max_num_seqs / concurrent synthesize slots.
FISH_SPEECH_MAX_CONCURRENT_REQUESTS=6
# Optional default reference transcript when the client sends audio without text.
FISH_SPEECH_DEFAULT_REFERENCE_TEXT=
# If true, resolve FISH_SPEECH_LLAMA_CHECKPOINT to the merged fine-tune for CLI infer.
# vLLM does not read this — it loads FISH_SPEECH_MODEL as given (set it to training/vllm).
FISH_SPEECH_USE_FINETUNED=false
# Dump recent synthesize requests under {DATA_ROOT}/logs/synthesis/ (raw+final WAV + JSON).
FISH_SPEECH_SYNTH_LOG=true
# How many newest synthesis dumps to keep.
FISH_SPEECH_SYNTH_LOG_KEEP=40

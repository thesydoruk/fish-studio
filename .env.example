# Fish Speech TTS server + dataset builder — project config
# Copy:  cp .env.example .env
#
# Full Ukrainian LoRA path: docs/ukrainian-lora-playbook.md
# Docker Compose overrides DATA_ROOT and FISH_SPEECH_BASE_URL on its own.

# --- paths (work/, datasets/, checkpoints/, training/, logs/) ---
DATA_ROOT=./data

# --- sources (JSON array for fish-dataset run; processed sequentially) ---
# SOURCES=[{"id":"youtube-channel-1","kind":"youtube","enabled":true,"url":"https://www.youtube.com/@CHANNEL/videos","speaker_name":"host"}]
SOURCES=[]

# --- audio_intel (remote transcription) ---
# Server must enable matching flags: WORD_ALIGN_ENABLED, SPEAKERS_ENABLED (+ HF_TOKEN),
# SOUND_EVENTS_ENABLED. Request flags below are ignored when the server feature is off.
# With SOUND_EVENTS_ENABLED, keep ASR_PARALLEL_WORKERS low (1–2) to avoid CUDA OOM.
AUDIO_INTEL_BASE_URL=http://127.0.0.1:8081
# Use "auto" for bilingual UK/EN lessons; "uk" for monolingual Ukrainian.
AUDIO_INTEL_LANGUAGE=uk
AUDIO_INTEL_ALIGN=true
AUDIO_INTEL_DIARIZE=true
AUDIO_INTEL_SOUND_EVENTS=true
AUDIO_INTEL_TIMEOUT_SEC=7200
AUDIO_INTEL_DROP_FAILED_SEGMENTS=true

# --- segmentation ---
SEGMENTATION_MIN_DURATION_SEC=1.5
SEGMENTATION_MAX_DURATION_SEC=12.0
SEGMENTATION_TARGET_DURATION_SEC=6.0
SEGMENTATION_MIN_SPEECH_DURATION_SEC=0.5
SEGMENTATION_MIN_CHARS=10
SEGMENTATION_MAX_CHARS=220
SEGMENTATION_PADDING_SEC=0.05
# Match Fish Speech s2-pro codec sample rate.
SEGMENTATION_SAMPLE_RATE=44100
SEGMENTATION_MERGE_GAP_SEC=0.3
# true drops non-uk when AUDIO_INTEL_LANGUAGE=uk. For bilingual auto ASR, set false.
SEGMENTATION_FILTER_NON_TARGET_LANGUAGE=true
# Split aligned words into uk/en runs (Latin vs Cyrillic). On for bilingual teachers.
SEGMENTATION_SPLIT_BY_SCRIPT=false
# Keep only these languages after script split. Russian and other LID tags are dropped.
SEGMENTATION_ALLOWED_LANGUAGES=uk,en
SEGMENTATION_NORMALIZE_LOUDNESS=true
SEGMENTATION_TARGET_LOUDNESS_LUFS=-18.0
SEGMENTATION_TRUE_PEAK_DB=-1.0
SEGMENTATION_LOUDNESS_RANGE=7.0

# --- quality ---
QUALITY_MIN_AVG_LOGPROB=-1.0
QUALITY_MAX_NO_SPEECH_PROB=0.6
QUALITY_DROP_COMPRESSION_RATIO_OUTLIERS=true
QUALITY_MAX_COMPRESSION_RATIO=2.4
QUALITY_MIN_AVG_WORD_SCORE=0.5
QUALITY_MIN_WORD_SCORE=0.25
QUALITY_MAX_LOW_SCORE_WORD_RATIO=0.35
# Skipped when SEGMENTATION_NORMALIZE_LOUDNESS=true — loudnorm rewrites levels on export.
QUALITY_FILTER_AUDIO_QUALITY=true
QUALITY_MIN_MEAN_VOLUME_DB=-40.0
QUALITY_MAX_MEAN_VOLUME_DB=-8.0
QUALITY_MAX_PEAK_VOLUME_DB=-1.0
# Non-speech junk filtering is hardcoded: any clip overlapping a sound_event is
# dropped. Requires AUDIO_INTEL_SOUND_EVENTS=true and server SOUND_EVENTS_ENABLED=1.

# --- export ---
EXPORT_SPEAKER_NAME=speake
EXPORT_EVAL_SPLIT_SIZE=0.05
EXPORT_SEED=42
EXPORT_REFERENCE_DURATION_SEC=8.0
EXPORT_REFERENCE_SAMPLE_RATE=44100

# --- speaker clustering (cross-video within one SOURCES channel) ---
# Cosine threshold for merging video-local speakers into {EXPORT_SPEAKER_NAME}_s{k}.
# Requires diarization roster embeddings in transcript JSON.
SPEAKER_CLUSTER_THRESHOLD=0.75
# After cluster remap, drop speakers below either floor (junk diarization tails).
SPEAKER_CLUSTER_MIN_CLIPS=100
SPEAKER_CLUSTER_MIN_SPEECH_SEC=300

# --- pipeline ---
PIPELINE_STEPS=all
PIPELINE_FORCE=false
PIPELINE_NUM_WORKERS=6

# --- training (./run.sh train / bg-train) ---
# Point at the merged giant set from: ./run.sh dataset merge -o combined
TRAINING_DATASET_ID=combined
TRAINING_SPEAKER_NAME=speake
# Change the project name for each fresh run (creates training/runs/<name>/).
TRAINING_PROJECT_NAME=fish-uk
TRAINING_BASE_CHECKPOINT=
TRAINING_MERGED_CHECKPOINT=
TRAINING_MAX_STEPS=10000
TRAINING_BATCH_SIZE=4
TRAINING_GRAD_ACCUM=1
TRAINING_LR=0.0001
TRAINING_VAL_CHECK_INTERVAL=100
# -1 keeps every checkpoint (~97 MB each) so the best step can be chosen by ea
TRAINING_SAVE_TOP_K=-1
TRAINING_LORA_CONFIG=r_8_alpha_16
TRAINING_LORA_R=8
TRAINING_LORA_ALPHA=16
TRAINING_LORA_DROPOUT=0.01
# All eight Dual-AR LoRA targets, listed explicitly (slow names would also
# imply their fast_* pair, but the full list is harder to misread).
# Slow = pronunciation + token table; fast_* = acoustics / timbre.
TRAINING_LORA_TARGET_MODULES=attention,mlp,embeddings,output,fast_attention,fast_mlp,fast_embeddings,fast_output
TRAINING_CONTINUE_PATH=
TRAINING_VQ_BATCH_SIZE=16
TRAINING_VQ_NUM_WORKERS=1
TRAINING_PROTO_NUM_WORKERS=8
TRAINING_PROTO_SHARD_SIZE_MB=10
TRAINING_TEST_TEXT=Доброго дня! Вартість квитка 150 грн, знижка 10 відсотків.

# --- stress marks (Ukrainian lexical stress) ---
# Applied during dataset/train export AND to synthesis input. The model learns to
# read the marks during fine-tuning, so changing these after export means re-export
# (./run.sh train export) → vq → protos → retrain from the base checkpoint.
STRESS_ENABLED=true
# skip = leave unresolved heteronyms unmarked; first = guess; all = mark every option
STRESS_ON_AMBIGUITY=skip
# dictionary = lookup only; stanza = context-aware heteronyms (+~500 MB models, needs `pip install stanza`)
STRESS_DISAMBIGUATION=stanza
# Custom overrides (names / OOV). Relative to this .env file. Empty disables.
STRESS_LEXICON_PATH=configs/stress_lexicon.txt
# Keep Stanza on CPU so marking does not contend with the TTS GPU.
STRESS_PREFER_CPU=true
# Mark remaining OOV words from clip energy during dataset export (not used at synthesis).
STRESS_ACOUSTIC_FALLBACK=true

# --- inference (HTTP TTS server) ---
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8080
INFERENCE_DEVICE=cuda
INFERENCE_LANGUAGE=uk
INFERENCE_MAX_UPLOAD_BYTES=15728640

# --- fish_speech (vLLM-Omni: ./run.sh vllm start) ---
FISH_SPEECH_BASE_URL=http://127.0.0.1:8091
VLLM_PORT=8091
VLLM_PUBLISH_PORT=8091
SERVER_PUBLISH_PORT=8080
FISH_SPEECH_MODEL=checkpoints/fish-speech/s2-pro
# Keep in sync with stage 0 in configs/fish_speech_deploy.yaml.
FISH_SPEECH_GPU_MEMORY_UTILIZATION=0.72
# Reduce CUDA allocator fragmentation so DAC can use leftover VRAM.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
FISH_SPEECH_VOICE=default
FISH_SPEECH_TIMEOUT_SEC=300.0
FISH_SPEECH_LLAMA_CHECKPOINT=checkpoints/fish-speech/s2-pro
FISH_SPEECH_DECODER_CHECKPOINT=
FISH_SPEECH_DECODER_CONFIG_NAME=modded_dac_vq
FISH_SPEECH_HALF=true
FISH_SPEECH_COMPILE=false
# Max characters per vLLM request. Longer text is split on sentence boundaries
# so each generation stays closer to the 6–12 s clips the model was trained on.
FISH_SPEECH_CHUNK_LENGTH=200
FISH_SPEECH_MAX_NEW_TOKENS=0
FISH_SPEECH_MAX_CONCURRENT_REQUESTS=6
FISH_SPEECH_DEFAULT_REFERENCE_TEXT=
FISH_SPEECH_USE_FINETUNED=false

# syntax=docker/dockerfile:1

FROM python:3.11-slim-bookworm

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps before copying src so code edits do not invalidate this layer.
COPY pyproject.toml README.md ./

# Skip the project extra `fish-speech` (training stack). Server needs HTTP deps,
# stress marking, and Praat PSOLA timing stretch (CPU). Install CPU torch first
# so Stanza does not pull CUDA.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install \
        "protobuf>=4.25.3,<6" \
        "fastapi>=0.110" \
        "uvicorn[standard]>=0.27" \
        "python-multipart>=0.0.9" \
        "soundfile>=0.12" \
        "PyYAML>=6.0" \
        "httpx>=0.27" \
        "python-dotenv>=1.0" \
        "ukrainian-word-stress>=2.1" \
        "stanza>=1.8" \
        "praat-parselmouth>=0.4.3" \
    && python -c "import stanza; stanza.download('uk', processors='tokenize,pos,mwt')" \
    && python -c "import parselmouth; from parselmouth.praat import call; print(parselmouth.__version__)"

COPY src ./src
COPY configs/stress_lexicon.txt configs/
COPY docker/server-entrypoint.sh docker/healthcheck-server.sh docker/

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps .

RUN chmod +x docker/server-entrypoint.sh docker/healthcheck-server.sh

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["/app/docker/healthcheck-server.sh"]

ENTRYPOINT ["/app/docker/server-entrypoint.sh"]
